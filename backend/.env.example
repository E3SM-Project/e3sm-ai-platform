# =============================================================================
# E3SM AI Platform backend configuration
# =============================================================================
# Copy this file to backend/.env for local use only. Never commit credentials.

# =============================================================================
# Response generation and LivAI
# =============================================================================
# Deterministic generation is the default. Set to "livai" or "argo" only when
# that provider is configured below. Any other value stays deterministic.
INFERENCE_BACKEND=deterministic

# LivAI uses an OpenAI-compatible endpoint. Keep the API key local and secret.
LIVAI_API_KEY=
LIVAI_MODEL=gpt-5.5
LIVAI_BASE_URL=https://livai-api.llnl.gov/

# Argo is the ANL LLM gateway and is reachable only from the ANL network.
# It authenticates with an ANL username sent in the request body, not a bearer
# token, so ARGO_USER is an identifier rather than a secret. ARGO_API_KEY is
# accepted as a fallback because existing ANL tooling already exports it.
# Known models include gpt4o, gpto1, gpto3mini, claudesonnet45, gemini25pro.
ARGO_USER=
ARGO_MODEL=gpt4o
ARGO_BASE_URL=https://apps.inside.anl.gov/argoapi

# =============================================================================
# API access
# =============================================================================
# Comma-separated browser origins allowed to call the FastAPI backend.
CORS_ALLOW_ORIGINS=http://localhost:5173

# =============================================================================
# Retrieval
# =============================================================================
# Offline-safe lexical retrieval is the default. Semantic and hybrid modes load
# the configured Hugging Face model when the backend service starts.
RETRIEVAL_MODE=lexical
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Lexical gates preserve the deterministic defaults. Semantic scores are cosine
# similarities, not probabilities, and should be calibrated for the selected model.
RETRIEVAL_LEXICAL_MIN_COVERAGE=0.18
RETRIEVAL_LEXICAL_MIN_SCORE=0.11
RETRIEVAL_SEMANTIC_MIN_SCORE=0.7

# Hybrid score is the normalized weighted average of lexical relevance and semantic similarity.
RETRIEVAL_LEXICAL_WEIGHT=0.5
RETRIEVAL_SEMANTIC_WEIGHT=0.5

# =============================================================================
# Observability
# =============================================================================
# Tracing is disabled unless an OTLP HTTP traces endpoint is explicitly set.
# Telemetry service.name for this emitting backend API process.
SERVICE_NAME=e3sm-ai-platform-backend
DEPLOYMENT_ENVIRONMENT=development
OTLP_ENDPOINT=
# Optional comma-separated key=value values. Never log these headers.
OTLP_HEADERS=
